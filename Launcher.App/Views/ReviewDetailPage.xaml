<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Launcher.App.Views"
                       xmlns:vm="clr-namespace:Launcher.App.ViewModels"
                       x:Class="Launcher.App.Views.ReviewDetailPage"
                       x:DataType="vm:ReviewDetailViewModel"
                       Shell.NavBarIsVisible="False"
                       Shell.TabBarIsVisible="False"
                       Title="Review"
                       BackgroundColor="#352A2A">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="14" Margin="0,0,0,16">
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    BackgroundColor="#4A4040"
                    TextColor="White"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    Command="{Binding GoBackCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding GameName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="#4A4040"
                Stroke="#5A5050"
                StrokeThickness="1"
                Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               TextColor="White"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="By: " TextColor="#CCAAAA" />
                                    <Span Text="{Binding UserName}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Column="1"
                               TextColor="#FFCC33"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="★ " />
                                    <Span Text="{Binding Review.Rating}" />
                                    <Span Text="/5" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#5A5050" />

                    <Label Text="{Binding Review.Text}"
                           TextColor="White"
                           FontSize="15"
                           LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="1" Color="#5A5050" />

                    <Label TextColor="#AA8888"
                           FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Posted: " />
                                <Span Text="{Binding Review.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <HorizontalStackLayout Grid.Row="2"
                               Spacing="12"
                               HorizontalOptions="End"
                               Margin="0,16,0,0">
            <Button Text="Edit"
                    Command="{Binding GoToEditCommand}"
                    BackgroundColor="#4A4040"
                    TextColor="White"
                    WidthRequest="100"
                    HeightRequest="42"
                    IsVisible="{Binding CanEdit}" />

            <Button Text="Delete"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#AA3333"
                    TextColor="White"
                    WidthRequest="100"
                    HeightRequest="42"
                    IsVisible="{Binding CanEdit}" />
        </HorizontalStackLayout>

    </Grid>
</views:ContentPageBase>
