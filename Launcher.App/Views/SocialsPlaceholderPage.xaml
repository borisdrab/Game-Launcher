<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Launcher.App.Views"
                       x:Class="Launcher.App.Views.SocialsPlaceholderPage"
                       Shell.NavBarIsVisible="False"
                       Shell.TabBarIsVisible="False"
                       Title="Socials"
                       BackgroundColor="#352A2A">
    <Grid RowDefinitions="Auto, *">
        <views:NavigationBarView Grid.Row="0" ActiveTab="Socials" />
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Socials" FontSize="24" HorizontalOptions="Center" TextColor="White" />
            <Label Text="Placeholder" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
