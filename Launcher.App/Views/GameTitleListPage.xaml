<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Launcher.App.Views"
                       xmlns:vm="clr-namespace:Launcher.App.ViewModels"
                       xmlns:m="clr-namespace:Launcher.BL.Models;assembly=Launcher.BL"
                       x:Class="Launcher.App.Views.GameTitleListPage"
                       x:DataType="vm:GameTitleListViewModel"
                       x:Name="GameTitleListRoot"
                       Shell.NavBarIsVisible="False"
                       Shell.TabBarIsVisible="False"
                       BackgroundColor="#352A2A">

    <Grid RowDefinitions="Auto, *">

        <!-- ===== TOP NAVIGATION BAR ===== -->
        <views:NavigationBarView Grid.Row="0" ActiveTab="Obchod" />

        <!-- ===== CONTENT: Sidebar + Game Grid ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="160, *">

            <!-- ===== LEFT SIDEBAR ===== -->
            <ScrollView Grid.Column="0" BackgroundColor="#333030">
                <VerticalStackLayout Padding="10" Spacing="6">

                    <!-- Search Bar -->
                    <Border BackgroundColor="#4A4444"
                            Stroke="#5A5252"
                            StrokeThickness="1"
                            Padding="0"
                            HeightRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <SearchBar Placeholder="Search"
                                   Text="{Binding SearchText}"
                                   PlaceholderColor="#999999"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="White" />
                    </Border>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" Color="#5A4A4A" Margin="0,2" />

                    <!-- Genre Filter Buttons -->
                    <CollectionView ItemsSource="{Binding Genres}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:GenreListModel">
                                <Border BackgroundColor="#4A4444"
                                        Stroke="#5A5252"
                                        StrokeThickness="1"
                                        Padding="10,4"
                                        Margin="4,2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               HorizontalOptions="StartAndExpand" />
                                        <CheckBox Color="#CC3333"
                                                  VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ===== MAIN CONTENT - Game Cards Grid ===== -->
            <ScrollView Grid.Column="1">
                <CollectionView ItemsSource="{Binding Games}"
                                Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="4"
                                         HorizontalItemSpacing="10"
                                         VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <!-- Empty state -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="8"
                                             Padding="0,80">
                            <Label Text="No games found"
                                   FontSize="20"
                                   TextColor="#AA8888"
                                   HorizontalOptions="Center" />
                            <Label Text="Games will appear here once added to the database"
                                   FontSize="14"
                                   TextColor="#776666"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:GameTitleListModel">
                            <Border BackgroundColor="#4A4040"
                                    Padding="0"
                                    StrokeThickness="0"
                                    HeightRequest="200">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference GameTitleListRoot}, Path=BindingContext.GoToDetailCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="*, Auto">
                                    <!-- Game Cover Image -->
                                    <Image Grid.Row="0"
                                           Source="{Binding CoverImageUrl}"
                                           Aspect="AspectFill"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />

                                    <!-- Placeholder icon when no image -->
                                    <Label Grid.Row="0"
                                           Text="🎮"
                                           FontSize="40"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />

                                    <!-- Game Title -->
                                    <Border Grid.Row="1"
                                            BackgroundColor="#332828"
                                            Padding="6,4"
                                            StrokeThickness="0">
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

        </Grid>
    </Grid>
</views:ContentPageBase>
