<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Launcher.App.Views"
                       xmlns:vm="clr-namespace:Launcher.App.ViewModels"
                       xmlns:m="clr-namespace:Launcher.BL.Models;assembly=Launcher.BL"
                       x:Class="Launcher.App.Views.UserListPage"
                       x:DataType="vm:UserListViewModel"
                       x:Name="UserListRoot"
                       Shell.NavBarIsVisible="False"
                       Shell.TabBarIsVisible="False"
                       BackgroundColor="#352A2A">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <CollectionView ItemsSource="{Binding Users}"
                            Margin="16,32,16,0"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="4"
                                     HorizontalItemSpacing="16"
                                     VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="0,60">
                        <Label Text="No users yet"
                               FontSize="18"
                               TextColor="#AA8888"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:UserListModel">
                        <VerticalStackLayout Spacing="6" Padding="4">

                            <Border BackgroundColor="#4A3838"
                                    WidthRequest="100"
                                    HeightRequest="100"
                                    Stroke="#666666"
                                    StrokeThickness="2"
                                    HorizontalOptions="Center"
                                    Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="50" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference UserListRoot}, Path=BindingContext.SelectUserCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding AvatarUrl}"
                                       Aspect="AspectFill"
                                       WidthRequest="90"
                                       HeightRequest="90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Text="{Binding UserName}"
                                   TextColor="White"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </ScrollView>

        <Border Grid.Row="1"
                BackgroundColor="#2D2424"
                Padding="16,10"
                StrokeThickness="0">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="+ Add User"
                        Command="{Binding AddUserCommand}"
                        BackgroundColor="#4A4444"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="24,8" />
                <Button Text="Edit Users"
                        Command="{Binding EditUsersCommand}"
                        BackgroundColor="#4A4444"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="24,8" />
            </HorizontalStackLayout>
        </Border>

    </Grid>
</views:ContentPageBase>
