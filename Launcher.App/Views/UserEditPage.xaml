<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Launcher.App.Views"
                       xmlns:vm="clr-namespace:Launcher.App.ViewModels"
                       xmlns:m="clr-namespace:Launcher.BL.Models;assembly=Launcher.BL"
                       x:Class="Launcher.App.Views.UserEditPage"
                       x:DataType="vm:UserEditViewModel"
                       x:Name="UserEditRoot"
                       Shell.NavBarIsVisible="False"
                       Shell.TabBarIsVisible="False"
                       BackgroundColor="#352A2A">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        
        <Grid Grid.Row="0"
              BackgroundColor="#2D2424"
              HeightRequest="48"
              ColumnDefinitions="Auto, *">
            <Button Grid.Column="0"
                    Text="←"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="20"
                    Padding="16,0" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="0,0,60,0" />
        </Grid>
        
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Users}"
                        HeightRequest="130"
                        BackgroundColor="#2D2424"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <BoxView WidthRequest="16" HeightRequest="130" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <VerticalStackLayout Spacing="4"
                                     WidthRequest="76"
                                     Padding="0,14,0,0"
                                     Margin="0,0,16,0">
                    <Border WidthRequest="70"
                            HeightRequest="70"
                            BackgroundColor="#3A3030"
                            Stroke="#555555"
                            StrokeThickness="2"
                            HorizontalOptions="Center"
                            Margin="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="35" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference UserEditRoot}, Path=BindingContext.AddNewUserCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               TextColor="#888888"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="Add user"
                           TextColor="#888888"
                           FontSize="11"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:UserListModel">
                    <Grid WidthRequest="80" HeightRequest="130" Padding="0,14,0,0">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Start">
                            <Border WidthRequest="80"
                                    HeightRequest="80"
                                    BackgroundColor="#4A3838"
                                    Stroke="#666666"
                                    StrokeThickness="2"
                                    HorizontalOptions="Center"
                                    Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="40" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference UserEditRoot}, Path=BindingContext.SelectUserCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding AvatarUrl}"
                                       Aspect="AspectFill"
                                       WidthRequest="70"
                                       HeightRequest="70"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="{Binding UserName}"
                                   TextColor="White"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Text="✕"
                            BackgroundColor="#CC3333"
                            TextColor="White"
                            FontSize="9"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference UserEditRoot}, Path=BindingContext.DeleteUserCommand}"
                                    CommandParameter="{Binding Id}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="4" Padding="40,24">

                <Label Text="Name" TextColor="#AA8888" FontSize="13" Margin="0,0,0,4" />
                <Border BackgroundColor="#3D3333"
                        StrokeThickness="1"
                        Stroke="#5A5252"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding DisplayName}"
                           Placeholder="Display name"
                           PlaceholderColor="#777777"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Margin="0" />
                </Border>
                <Label Text="{Binding DisplayNameError}"
                       TextColor="#CC3333"
                       FontSize="12"
                       IsVisible="{Binding HasDisplayNameError}"
                       Margin="4,0,0,8" />

                <Label Text="Nick" TextColor="#AA8888" FontSize="13" Margin="0,8,0,4" />
                <Border BackgroundColor="#3D3333"
                        StrokeThickness="1"
                        Stroke="#5A5252"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding UserName}"
                           Placeholder="Username (letters, digits, underscore)"
                           PlaceholderColor="#777777"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Margin="0" />
                </Border>
                <Label Text="{Binding UserNameError}"
                       TextColor="#CC3333"
                       FontSize="12"
                       IsVisible="{Binding HasUserNameError}"
                       Margin="4,0,0,8" />

                <Label Text="Email" TextColor="#AA8888" FontSize="13" Margin="0,8,0,4" />
                <Border BackgroundColor="#3D3333"
                        StrokeThickness="1"
                        Stroke="#5A5252"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Email}"
                           Placeholder="email@example.com"
                           PlaceholderColor="#777777"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Keyboard="Email"
                           Margin="0" />
                </Border>
                <Label Text="{Binding EmailError}"
                       TextColor="#CC3333"
                       FontSize="12"
                       IsVisible="{Binding HasEmailError}"
                       Margin="4,0,0,8" />

                <Label Text="Avatar URL" TextColor="#AA8888" FontSize="13" Margin="0,8,0,4" />
                <Border BackgroundColor="#3D3333"
                        StrokeThickness="1"
                        Stroke="#5A5252"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding AvatarUrl}"
                           Placeholder="https://... (optional)"
                           PlaceholderColor="#777777"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Margin="0" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        
        <Border Grid.Row="3"
                BackgroundColor="#2D2424"
                Padding="20,12"
                StrokeThickness="0">
            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#CC3333"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    Padding="0,12"
                    HorizontalOptions="Fill" />
        </Border>

    </Grid>
</views:ContentPageBase>
